						["Reflection.FaceOnStrength"] = Input { Value = 0.503, Expression = "CARD_CONTROLS.FadeOut*(FB_PlateCTRL.NumberIn8*(1-(1-math.min(1,math.max(0,(time-CARD_CONTROLS.AnimStart-8*CARD_CONTROLS.AnimSpeed)/(18*CARD_CONTROLS.AnimSpeed))))^3))", },
						MaterialID = Input { Value = 22, },
					},
				},
				FB_EnvSquare = BetterResize {
					ViewInfo = OperatorInfo {
						Pos = { 1009, 47.68 },
					},
					Inputs = {
						Width = Input { Value = 1024, },
						Height = Input { Value = 1024, },
						PixelAspect = Input {
							Value = { 1, 1 },
						},
						HiQOnly = Input { Value = 0, },
					},
				},
				FB_EnvTopEye = Crop {
					ViewInfo = OperatorInfo {
						Pos = { 1155, 45.58 },
					},
					Inputs = {
						Input = Input { SourceOp = "FB_EnvSquare", Source = "Output", },
						XOffset = Input { Value = 0, },
						XSize = Input { Value = 1024, },
						YOffset = Input { Expression = "iif(CARD_CONTROLS.EnvOverUnder > 0.5, 512, 0)", },
						YSize = Input { Expression = "iif(CARD_CONTROLS.EnvOverUnder > 0.5, 512, 1024)", },
					},
				},
			},
