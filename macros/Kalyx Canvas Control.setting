					Name = "Glow Amount (0 = off)",
					Default = 0.7, MinScale = 0, MaxScale = 1, Page = "Glow",
				},
				-- ===== PLACEMENT =====
				Yaw = InstanceInput {
					SourceOp = "Left_Place_On_Sphere", Source = "Transform3DOp.Rotate.Y",
