{
	Tools = ordered() {
		Kalyx_Trim = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Trim_CC", Source = "Input", Name = "Picture", },
				Exposure = InstanceInput {
					SourceOp = "Trim_CC",
					Source = "MasterRGBBrightness",
					Name = "Exposure (offset)",
					Default = 0,
					MinScale = -0.5,
					MaxScale = 0.5,
					Page = "Trim",
				},
				Lift = InstanceInput {
					SourceOp = "Trim_CC",
					Source = "MasterRGBLift",
					Name = "Lift",
					Default = 0,
					MinScale = -0.25,
					MaxScale = 0.25,
					Page = "Trim",
				},
				Gamma = InstanceInput {
					SourceOp = "Trim_CC",
					Source = "MasterRGBGamma",
					Name = "Gamma",
					Default = 1,
					MinScale = 0.5,
					MaxScale = 2,
					Page = "Trim",
				},
				Gain = InstanceInput {
					SourceOp = "Trim_CC",
					Source = "MasterRGBGain",
					Name = "Gain",
					Default = 1,
					MinScale = 0,
					MaxScale = 2,
					Page = "Trim",
				},
				Contrast = InstanceInput {
					SourceOp = "Trim_CC",
					Source = "MasterRGBContrast",
					Name = "Contrast",
					Default = 1,
					MinScale = 0.5,
					MaxScale = 2,
					Page = "Trim",
				},
				Saturation = InstanceInput {
					SourceOp = "Trim_CC",
					Source = "Saturation1",
					Name = "Saturation",
					Default = 1,
					MinScale = 0,
					MaxScale = 2,
					Page = "Trim",
				},
				Temperature = InstanceInput {
					SourceOp = "Kalyx_TrimControls",
					Source = "Temperature",
					Name = "Temperature (blue - amber)",
					Default = 0,
					MinScale = -1,
					MaxScale = 1,
					Page = "Trim",
				},
				Tint = InstanceInput {
					SourceOp = "Kalyx_TrimControls",
					Source = "Tint",
					Name = "Tint (green - magenta)",
					Default = 0,
					MinScale = -1,
					MaxScale = 1,
					Page = "Trim",
				},
				Amount = InstanceInput {
					SourceOp = "Trim_CC",
					Source = "Blend",
					Name = "Amount (0 = off)",
					Default = 1,
					MinScale = 0,
					MaxScale = 1,
					Page = "Trim",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Trim_CC", Source = "Output", Name = "Picture", },
			},
			Tools = ordered() {
				Kalyx_TrimControls = PipeRouter {
					CtrlWZoom = false,
					Inputs = {
						Temperature = Input { Value = 0, },
						Tint = Input { Value = 0, },
					},
					ViewInfo = PipeRouterInfo {
						Pos = { -220, -60 },
					},
					UserControls = ordered() {
						Temperature = {
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -1,
							INP_MaxScale = 1,
							INP_MinAllowed = -1,
							INP_MaxAllowed = 1,
							LINKS_Name = "Temperature (blue - amber)",
							ICS_ControlPage = "Trim",
						},
						Tint = {
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -1,
							INP_MaxScale = 1,
							INP_MinAllowed = -1,
							INP_MaxAllowed = 1,
							LINKS_Name = "Tint (green - magenta)",
							ICS_ControlPage = "Trim",
						},
					},
				},
				Trim_CC = ColorCorrector {
					Inputs = {
						MasterRGBBrightness = Input { Value = 0, },
						MasterRGBLift = Input { Value = 0, },
						MasterRGBGamma = Input { Value = 1, },
						MasterRGBGain = Input { Value = 1, },
						MasterRGBContrast = Input { Value = 1, },
						Saturation1 = Input { Value = 1, },
						MasterRedGain = Input { Value = 1, Expression = "1 + 0.25*Kalyx_TrimControls.Temperature + 0.08*Kalyx_TrimControls.Tint", },
						MasterGreenGain = Input { Value = 1, Expression = "1 - 0.16*Kalyx_TrimControls.Tint", },
						MasterBlueGain = Input { Value = 1, Expression = "1 - 0.25*Kalyx_TrimControls.Temperature + 0.08*Kalyx_TrimControls.Tint", },
					},
					ViewInfo = OperatorInfo {
						Pos = { 0, 0 },
					},
				},
			},
			ViewInfo = GroupInfo {
				Pos = { 0, 0 },
			},
		},
	},
}
