{
	Tools = ordered() {
		Kalyx_CanvasControl = MacroOperator {
			Inputs = ordered() {
				-- ===== FOOTAGE (connect your clips here) =====
				MainInput1 = InstanceInput {
					SourceOp = "Left_Footage_Input", Source = "Input",
					Name = "Left / Mono Footage",
				},
				MainInput2 = InstanceInput {
					SourceOp = "Right_Footage_Input", Source = "Input",
					Name = "Right Footage (stereo only)",
				},
				MainInput3 = InstanceInput {
					SourceOp = "Graphic_Input", Source = "Input",
					Name = "Graphic (title / stock, alpha kept, no frame)",
				},
				SceneInput = InstanceInput {
					SourceOp = "Scene_Offset", Source = "SceneInput",
					Name = "3D Scene (Kalyx 3D Titles, FBX / OBJ, built before this node)",
				},
				Source = InstanceInput {
					SourceOp = "Kalyx_Controls", Source = "WindowShows",
					Name = "Window shows",
					Default = 0, MinScale = 0, MaxScale = 2, Page = "Frame",
				},
				WindowAspect = InstanceInput {
					SourceOp = "Window_Aspect_Value", Source = "TopLeftRed",
					Name = "Window Aspect (width / height, 1.778 = 16:9)",
					Default = 1.778, MinScale = 1, MaxScale = 2.4, Page = "Frame",
				},
				-- ===== FRAME =====
				FrameColour = InstanceInput {
					SourceOp = "Frame_Colour", Source = "TopLeftRed",
					Name = "Frame Colour", ControlGroup = 14, Default = 1, Page = "Frame",
				},
				FrameColourG = InstanceInput {
					SourceOp = "Frame_Colour", Source = "TopLeftGreen",
					ControlGroup = 14, Default = 1, Page = "Frame",
				},
				FrameColourB = InstanceInput {
					SourceOp = "Frame_Colour", Source = "TopLeftBlue",
					ControlGroup = 14, Default = 1, Page = "Frame",
				},
				FrameThickness = InstanceInput {
					SourceOp = "FrameThickness_Value", Source = "TopLeftRed",
